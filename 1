<!-- Floating toggle — formal assistant (suit + headset), bottom-right -->
<button type="button" id="chat-fab" onclick="toggleChatPanel()"
        aria-label="Open Studio Assistant"
        style="position:fixed;bottom:24px;right:24px;z-index:9998;width:56px;height:56px;
               border-radius:50%;background:#1a1f2e;border:2px solid var(--accent);
               padding:0;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,0.4);
               display:flex;align-items:center;justify-content:center;overflow:hidden;">
  <svg id="chat-fab-img" width="56" height="56" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="32" cy="32" r="32" fill="#5b8cff"/>
    <path d="M10 58c4-12 12-18 22-18s18 6 22 18" fill="#1e293b"/>
    <path d="M26 42c2 4 4 6 6 6s4-2 6-6" fill="#334155"/>
    <path d="M28 44l4 8 4-8" fill="#f8fafc"/>
    <ellipse cx="32" cy="36" rx="7" ry="5" fill="#f0c9a0"/>
    <circle cx="32" cy="26" r="12" fill="#f2d3b1"/>
    <path d="M20 26c0-10 6-16 12-16s12 6 12 16c0 0-2-8-12-8S20 26 20 26z" fill="#2c1b18"/>
    <path d="M20 28c2 6 4 8 6 8M44 28c-2 6-4 8-6 8" fill="#2c1b18"/>
    <circle cx="28" cy="26" r="1.4" fill="#1e293b"/>
    <circle cx="36" cy="26" r="1.4" fill="#1e293b"/>
    <path d="M28 31c1.5 2 6.5 2 8 0" stroke="#b45309" stroke-width="1.2" fill="none" stroke-linecap="round"/>
    <path d="M20 24c0-10 5.5-15 12-15s12 5 12 15" stroke="#e2e8f0" stroke-width="2.2" fill="none" stroke-linecap="round"/>
    <rect x="17" y="22" width="5" height="9" rx="2.5" fill="#94a3b8"/>
    <rect x="42" y="22" width="5" height="9" rx="2.5" fill="#94a3b8"/>
    <path d="M19 30c-3 2-4 6-3 9" stroke="#cbd5e1" stroke-width="1.8" fill="none" stroke-linecap="round"/>
    <circle cx="16.5" cy="40" r="2.2" fill="#f8fafc"/>
  </svg>
</button>

<div id="chat-float-panel"
     style="display:none;position:fixed;bottom:92px;right:24px;z-index:9999;
            width:380px;max-width:calc(100vw - 48px);height:560px;max-height:calc(100vh - 140px);
            background:var(--panel);border:1px solid var(--border);border-radius:12px;
            box-shadow:0 10px 34px rgba(0,0,0,0.5);flex-direction:column;overflow:hidden;">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:0.7rem 0.9rem;border-bottom:1px solid var(--border);flex-shrink:0;">
    <span style="font-weight:600;font-size:0.9rem;">Studio Assistant</span>
    <span style="display:flex;align-items:center;gap:0.5rem;">
      <span id="chat-ws-status" style="font-size:0.7rem;color:var(--muted);padding:0.15rem 0.5rem;border:1px solid var(--border);border-radius:999px;">connecting…</span>
      <button type="button" id="chat-kb-toggle" onclick="toggleKbPanel()" style="font-size:0.68rem;background:transparent;border:1px solid var(--border);color:var(--muted);padding:0.15rem 0.5rem;">Docs ↗</button>
      <button type="button" onclick="toggleChatPanel()" title="Close"
              style="font-size:0.85rem;background:transparent;border:none;color:var(--muted);cursor:pointer;padding:0 0.2rem;">✕</button>
    </span>
  </div>
  <div id="chat-suggestions" style="display:flex;flex-wrap:wrap;gap:0.35rem;padding:0.6rem 0.9rem 0;flex-shrink:0;"></div>
  <div id="chat-messages"
       style="flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:0.7rem;padding:0.7rem 0.9rem;">
    <div class="chat-msg assistant">
      <div class="chat-bubble">
        Hello! I know everything about this studio — the pipeline, your channels, recent runs, and how every agent works. Ask me anything.
      </div>
    </div>
  </div>
  <div style="display:flex;gap:0.5rem;align-items:flex-end;padding:0.7rem 0.9rem;border-top:1px solid var(--border);flex-shrink:0;">
    <textarea id="chat-input"
              rows="1"
              placeholder="Ask anything about the studio…"
              style="flex:1;resize:none;background:#0f1117;border:1px solid var(--border);color:var(--text);border-radius:8px;padding:0.55rem 0.75rem;font-size:0.85rem;font-family:inherit;line-height:1.4;overflow-hidden;"
              onkeydown="handleChatKey(event)"
              oninput="autoResize(this)"></textarea>
    <button type="button" id="chat-send-btn" onclick="sendChatMessage()" style="white-space:nowrap;padding:0.55rem 1rem;font-size:0.85rem;">Send ↵</button>
  </div>
</div>

<script>
(function () {
  window.toggleChatPanel = function() {
    const panel = document.getElementById('chat-float-panel');
    const fab = document.getElementById('chat-fab');
    if (!panel) return;
    const isOpen = panel.style.display === 'flex';
    if (isOpen) {
      panel.style.display = 'none';
      if (fab) fab.style.opacity = '1';
    } else {
      panel.style.display = 'flex';
      if (fab) fab.style.opacity = '0.92';
      setTimeout(() => document.getElementById('chat-input')?.focus(), 50);
    }
  };

  let chatWs = null;
  let isStreaming = false;
  let currentBotBubble = null;
  let currentStreamText = '';
  let lastQuestion = '';

  function connectChatWs() {
    const proto = location.protocol === 'https:' ? 'wss' : 'ws';
    chatWs = new WebSocket(`${proto}://${location.host}/ws/chat`);
    chatWs.onopen = () => setStatus('live', 'var(--green)');
    chatWs.onclose = () => {
      setStatus('disconnected', 'var(--red)');
      setTimeout(connectChatWs, 3000);
    };
    chatWs.onerror = () => setStatus('error', 'var(--red)');
    chatWs.onmessage = (evt) => handleChatMessage(evt.data);
  }

  function setStatus(text, color) {
    const el = document.getElementById('chat-ws-status');
    if (el) { el.textContent = text; el.style.color = color; el.style.borderColor = color; }
  }

  function showThinking() {
    removeThinking();
    const box = document.getElementById('chat-messages');
    if (!box) return;
    const row = document.createElement('div');
    row.className = 'chat-msg assistant';
    row.id = 'chat-thinking-row';
    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble';
    bubble.style.color = 'var(--muted)';
    bubble.style.fontStyle = 'italic';
    bubble.textContent = 'Thinking… searching docs and live system state…';
    row.appendChild(bubble);
    box.appendChild(row);
    scrollChat();
  }

  function removeThinking() {
    document.getElementById('chat-thinking-row')?.remove();
  }

  function handleChatMessage(raw) {
    let msg;
    try { msg = JSON.parse(raw); } catch { return; }

    if (msg.type === 'history') {
      if (msg.messages && msg.messages.length) {
        const box = document.getElementById('chat-messages');
        box.innerHTML = '';
        msg.messages.forEach(m => appendMessage(m.role, m.content, m.sources || []));
        scrollChat();
      }
      return;
    }

    if (msg.type === 'suggested') {
      renderSuggestions(msg.questions || []);
      return;
    }

    if (msg.type === 'token') {
      removeThinking();
      if (!currentBotBubble) {
        currentBotBubble = appendMessage('assistant', '', [], true);
        currentStreamText = '';
      }
      currentStreamText += msg.text;
      currentBotBubble.textContent = currentStreamText;
      scrollChat();
      return;
    }

    if (msg.type === 'done') {
      removeThinking();
      isStreaming = false;
      setInputEnabled(true);
      if (currentBotBubble && msg.sources && msg.sources.length) {
        appendSources(currentBotBubble, msg.sources);
        if (!msg.low_confidence) appendFlagButton(currentBotBubble);
      } else if (currentBotBubble) {
        appendFlagButton(currentBotBubble);
      }
      currentBotBubble = null;
      scrollChat();
      return;
    }

    if (msg.type === 'escalated') {
      removeThinking();
      appendMessage('assistant', `⚑ ${msg.text}`, []);
      scrollChat();
      return;
    }

    if (msg.type === 'error') {
      removeThinking();
      isStreaming = false;
      setInputEnabled(true);
      currentBotBubble = null;
      appendMessage('assistant', `⚠ ${msg.text}`, []);
      scrollChat();
    }
  }

  window.sendChatMessage = function() {
    if (isStreaming) return;
    const input = document.getElementById('chat-input');
    const text = input.value.trim();
    if (!text || !chatWs || chatWs.readyState !== WebSocket.OPEN) return;
    lastQuestion = text;
    input.value = '';
    autoResize(input);
    const sug = document.getElementById('chat-suggestions');
    if (sug) sug.style.display = 'none';
    appendMessage('user', text, []);
    isStreaming = true;
    setInputEnabled(false);
    showThinking();
    scrollChat();
    chatWs.send(JSON.stringify({ type: 'question', text }));
  };

  window.handleChatKey = function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendChatMessage();
    }
  };

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey && e.key === '/') || (e.metaKey && e.key === 'k')) {
      e.preventDefault();
      const panel = document.getElementById('chat-float-panel');
      if (panel && panel.style.display !== 'flex') toggleChatPanel();
      document.getElementById('chat-input')?.focus();
    }
  });

  function appendMessage(role, content, sources, returnBubble) {
    const box = document.getElementById('chat-messages');
    const row = document.createElement('div');
    row.className = `chat-msg ${role}`;
    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble';
    bubble.textContent = content;
    row.appendChild(bubble);
    if (sources && sources.length) appendSources(bubble, sources);
    box.appendChild(row);
    scrollChat();
    return returnBubble ? bubble : row;
  }

  function appendSources(bubble, sources) {
    const src = document.createElement('div');
    src.className = 'chat-sources';
    src.textContent = 'Sources: ' + sources.map(s => s.title || s.type).join(' · ');
    bubble.parentElement.appendChild(src);
  }

  function appendFlagButton(bubble) {
    const btn = document.createElement('button');
    btn.textContent = '⚑ Flag';
    btn.title = "Flag this answer for investigation";
    btn.className = 'chat-flag-btn';
    btn.onclick = () => {
      if (chatWs && chatWs.readyState === WebSocket.OPEN) {
        chatWs.send(JSON.stringify({ type: 'flag' }));
        btn.textContent = '⚑ Flagged';
        btn.disabled = true;
      }
    };
    bubble.parentElement.appendChild(btn);
  }

  function renderSuggestions(questions) {
    const box = document.getElementById('chat-suggestions');
    if (!box) return;
    box.innerHTML = '';
    questions.forEach(q => {
      const chip = document.createElement('button');
      chip.className = 'chat-chip';
      chip.textContent = q;
      chip.onclick = () => {
        document.getElementById('chat-input').value = q;
        sendChatMessage();
      };
      box.appendChild(chip);
    });
  }

  function scrollChat() {
    const box = document.getElementById('chat-messages');
    if (box) box.scrollTop = box.scrollHeight;
  }

  function setInputEnabled(enabled) {
    const input = document.getElementById('chat-input');
    const btn = document.getElementById('chat-send-btn');
    if (input) input.disabled = !enabled;
    if (btn) btn.disabled = !enabled;
  }

  window.autoResize = function(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 120) + 'px';
  };

  window.toggleKbPanel = function() {
    const panel = document.getElementById('kb-panel');
    if (!panel) return;
    panel.style.display = panel.style.display === 'none' ? '' : 'none';
  };

  connectChatWs();
})();
</script>
